# Copia este archivo como .env y reemplaza todos los valores de ejemplo.
# Usa contrasenas largas y unicas, con letras y numeros.
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_CLAVE_ROOT
MYSQL_DATABASE=obligatorio
DB_ADMIN_PASSWORD=CAMBIAR_POR_CLAVE_ADMIN
DB_PLANILLERO_PASSWORD=CAMBIAR_POR_CLAVE_PLANILLERO
DB_AUTH_PASSWORD=CAMBIAR_POR_CLAVE_AUTH

# Usa un valor aleatorio largo (al menos 32 caracteres).
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRE_MINUTES=480

